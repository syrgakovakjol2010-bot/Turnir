const TelegramBot = require('node-telegram-bot-api');
require('dotenv').config();

const token = process.env.TELEGRAM_BOT_TOKEN;

if (!token) {
    console.error('❌ TELEGRAM_BOT_TOKEN не найден!');
}

// Если работаем на сервере (Vercel) — отключаем polling, иначе включаем
const isVercel = process.env.VERCEL === '1';
const bot = new TelegramBot(token, { polling: !isVercel });

console.log(`🚀 Telegram Bot запущен (Режим: ${isVercel ? 'Webhook' : 'Polling'})`);

// Обработка /start
bot.onText(/\/start(?:\s+(.+))?/, async (msg, match) => {
    const chatId = msg.chat.id;
    const parameter = match[1];
    const username = msg.from.username ? `@${msg.from.username}` : msg.from.first_name;

    if (parameter && parameter.startsWith('bind_')) {
        const siteUserId = parameter.replace('bind_', '');
        return bot.sendMessage(
            chatId,
            `✅ **Аккаунт привязан!**\n\nID на сайте: \`${siteUserId}\`\nTelegram: ${username}`,
            { parse_mode: 'Markdown' }
        );
    }

    bot.sendMessage(
        chatId,
        `👋 **Привет, ${msg.from.first_name}!**\n\nДобро пожаловать в **PlayNomad / PUBG Arena KG** 🎮\nБот готов к работе!`,
        { parse_mode: 'Markdown' }
    );
});

module.exports = { bot };
